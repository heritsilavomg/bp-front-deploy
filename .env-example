# Modele de bp-front/.env pour Next.js local.
# Docker Compose utilise ../.env ; Next.js charge ce fichier directement en developpement.
# Utiliser http://localhost:18080 si le backend tourne via Maven en profil local.
SPRING_BOOT_API=http://localhost:8080
AUTH_URL=http://localhost:3000
AUTH_SECRET=CHANGEZ_MOI_secret_auth_local_long_et_aleatoire
